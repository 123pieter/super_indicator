{
  "version": 1,
  "name": "Trend and Bollinger research example",
  "provider": "hyperliquid",
  "components": [
    {"rule": "sma_trend", "window": 100, "weight": 1.0},
    {"rule": "bollinger_reentry", "window": 20, "deviations": 2.0, "weight": 1.0}
  ],
  "combination": {"method": "weighted", "threshold": 0.5},
  "execution": {
    "initial_capital": 1000,
    "fee": 0.001,
    "slippage": 0.0005,
    "sizing": "fixed",
    "fraction": 0.1,
    "risk_fraction": 0.01,
    "max_exposure": 1.0,
    "stop_atr": 2.0,
    "target_atr": 3.0
  }
}
